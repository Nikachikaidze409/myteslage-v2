NODE_ENV=development
API_PORT=3000
WEB_PORT=5173

POSTGRES_DB=myteslage
POSTGRES_USER=myteslage
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://myteslage:change-me@postgres:5432/myteslage

REDIS_URL=redis://redis:6379

# Browser key is exposed to the browser by design. Restrict it in Google Cloud
# to approved HTTP referrers and only the APIs required by the web client.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=

# Optional Google Maps JavaScript Map ID. Use a Cloud Map Style with
# Buildings set to Footprints and tilt/rotation disabled.
VITE_GOOGLE_MAPS_MAP_ID=

# Keep privileged server-side provider keys in production secret storage.
GOOGLE_MAPS_SERVER_API_KEY=
